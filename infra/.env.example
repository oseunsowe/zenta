# ============================================================
#  PRODUCTION environment for infra/docker-compose.prod.yml
#
#    cp .env.example .env    # then fill in every REQUIRED value below
#
#  Do NOT copy backend/.env.example here — that one is tuned for local dev
#  (loopback CORS, relative database paths) and those values are wrong, and in
#  one case unsafe, for a public deployment.
#
#  Database and state paths are deliberately absent: docker-compose.prod.yml
#  pins them to the backend_state volume via `environment:`. Setting them here
#  would have no effect.
# ============================================================

APP_NAME=Zenta API
API_PREFIX=/api/v1

# ---------- REQUIRED secrets ----------

# Session signing key. At least 32 chars or the backend refuses to start.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=28800

# Runtime control for /admin/*. Leave EMPTY to disable those endpoints entirely.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# ---------- Invite gating ----------

INVITE_ONLY=true
# Comma-separated SHA-256 hex digests of accepted invite codes. Use long random
# codes, never DEMO-1. Generate one:
#   python -c "import hashlib;print(hashlib.sha256(b'YOUR-CODE').hexdigest())"
# Leaving this empty while INVITE_ONLY=true AND ADMIN_TOKEN is empty is a fatal
# startup error — nobody could ever log in.
INVITE_CODE_HASHES=
INVITE_RATE_LIMIT=5/minute
REQUIRE_INVITE_FOR_REGISTER=true
SHARE_REQUEST_TTL=300

# ---------- Frontend build ----------

# Your real public URL (e.g. https://zenta.example.com). Used only for the
# marketing page's canonical link, Open Graph image, and sitemap.xml — baked
# in at `docker compose ... up --build` time, so rebuild the frontend after
# changing it. Safe to leave empty for a quick-tunnel test; set it once you
# have a stable domain and care about search-engine indexing.
NEXT_PUBLIC_SITE_URL=

# ---------- Networking ----------

# Caddy terminates TLS and proxies /api -> backend on loopback. Nothing else
# reaches the container, so keep loopback mode.
BIND_MODE=loopback

# Leave EMPTY. Caddy serves the UI and the API on one origin, so the browser
# never makes a cross-origin request. Any value here grants a foreign origin
# credentialed access to this API.
CORS_ALLOW_ORIGINS=

# CIDRs allowed to reach /health. The Docker bridge network (172.16.0.0/12) is
# required for the compose healthcheck's sibling containers; loopback covers
# the container's own check. /health 404s for everyone else.
HEALTH_ALLOWED_CIDRS=127.0.0.0/8,::1/128,172.16.0.0/12

# ---------- LLM ----------

# 'echo' (no network, safe default) or 'groq'
LLM_PROVIDER=echo
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=15

# ---------- Memory ----------

# 'null' (stateless) or 'sqlite'. The sqlite path is set by compose.
MEMORY_BACKEND=null
MEMORY_WINDOW=10

# ---------- Optional bridges ----------

# Every chat reply is POSTed here. Empty disables.
WEBHOOK_OUT_URL=
WEBHOOK_OUT_TOKEN=

# POST /api/v1/bridge/inbound requires this in X-Bridge-Token.
# Empty disables the endpoint entirely (404).
BRIDGE_INBOUND_TOKEN=
