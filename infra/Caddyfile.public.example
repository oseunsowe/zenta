# Public production reverse proxy (Caddy v2).
# Automatic HTTPS via Let's Encrypt. Serves ONE origin: /api -> backend,
# everything else -> the Next.js frontend. WebSockets are handled automatically
# (that covers only the SDP/ICE *signaling* socket — low-bandwidth JSON, fine
# to proxy).
#
# WebRTC media, data channels, and TURN do NOT go through this file at all.
# Caddy is HTTP(S)-only and cannot proxy the raw UDP that TURN relays or that
# peer connections use — coturn (see infra/docker-compose.prod.yml's `coturn`
# service) listens directly on UDP 3478 + its relay port range, opened
# straight on the VPS firewall/security group, bypassing both Caddy and any
# Cloudflare tunnel entirely.
#
# Usage on the VPS:
#   1. Point your domain's A/AAAA record at the server.
#   2. Replace zenta.example.com below with your domain.
#   3. caddy run --config Caddyfile   (or install as a service)
#   4. Separately open UDP 3478 and the coturn relay range (see
#      infra/.env.example) directly — not through this Caddyfile.

zenta.example.com {
    encode zstd gzip

    # --- Security headers ---
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Allow screen capture only on our own origin; deny camera/mic/geo.
        Permissions-Policy "display-capture=(self), camera=(), microphone=(), geolocation=()"
        # Don't leak the server software.
        -Server
    }

    # --- API + widget loader + WebSockets -> backend (loopback only) ---
    @backend path /api/* /widget/*
    handle @backend {
        reverse_proxy 127.0.0.1:8000
    }

    # --- Desktop installer, served straight off disk ---
    # Put the built installer at /srv/downloads/Zenta-Setup.exe on the VPS.
    # The /download page HEADs this path, so a missing file shows as
    # "no build published yet" instead of a broken link.
    # No `browse`: only the exact filename is retrievable, not a directory index.
    handle /downloads/* {
        root * /srv
        file_server
    }

    # --- Everything else -> Next.js frontend ---
    handle {
        reverse_proxy 127.0.0.1:3000
    }
}
