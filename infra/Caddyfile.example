# Internal-only reverse proxy. Replace the CIDR with your VPN/office subnet.
# Caddy serves only to clients in the allowed range; everyone else gets 403.

internal.example.local {
    @internal remote_ip 10.0.0.0/8 192.168.0.0/16
    handle @internal {
        reverse_proxy 127.0.0.1:3000
        @api path /api/* /ws/*
        reverse_proxy @api 127.0.0.1:8000
    }
    handle {
        respond 403
    }
}
